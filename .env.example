# Copy this file to `.env.local` and fill in real values for local development.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SkillBridge Admin"
# Backend root including version prefix, e.g. http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# Required for NextAuth session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""
